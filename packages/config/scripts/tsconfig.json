{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "erasableSyntaxOnly": true,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": "..",
    "verbatimModuleSyntax": true
  },
  "include": ["./*.ts"]
}
