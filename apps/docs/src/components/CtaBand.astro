---
// Closing call to action for landing pages: a large title, an optional note,
// and whatever actions the page passes through the default slot (buttons
// using `.xt-btn` + `.xt-btn-primary` / `.xt-btn-ghost`, or a CopyCommand).
// Styling lives in apps/docs/src/styles/global.css (`.xt-band*`).
interface Props {
  title: string
  note?: string
}

const { title, note } = Astro.props
---

<div class="xt-band not-content">
  <h2 class="xt-band-title">{title}</h2>
  {note && <p class="xt-band-note">{note}</p>}
  <div class="xt-band-actions">
    <slot />
  </div>
</div>
