---
interface Props {
  note?: string
  title: string
}

const { note, title } = Astro.props
---

<section class="xt-band">
  <div class="xt-band-copy">
    <h2 class="xt-band-title">{title}</h2>
    {note && <p class="xt-band-note">{note}</p>}
  </div>
  <div class="xt-band-actions">
    <slot />
  </div>
</section>
