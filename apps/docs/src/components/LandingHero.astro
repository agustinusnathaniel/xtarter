---
// Type Starlight's App.Locals augmentation (starlightRoute) locally: the docs
// tsconfig does not include astro.config.mjs, so the integration's own d.ts
// files are not part of the program during `astro check`. The declaration
// merges with Starlight's when it is loaded.
declare global {
  namespace App {
    interface Locals {
      starlightRoute: import('@astrojs/starlight/route-data').StarlightRouteData
    }
  }
}
// Targeted Starlight Hero override for the three docs landing routes.
// For every other page it renders Starlight's default Hero unchanged, so
// hero frontmatter on non-target routes (404, future splash pages) keeps
// working. The `.hero` class and `<h1 id="_top" data-page-title>` are
// preserved so the existing tracking and page-title behavior stay intact.
//
// Each route owns one dominant charcoal artifact, with a different shape:
//   home   -> forked command strip (both entry commands)
//   xtz    -> the conformance-plan terminal output (TerminalDemo)
//   CXA    -> a narrow template-selection prompt (static markup)
// The artifacts are decorative by design and aria-hidden; their content is
// restated in visible page copy so assistive tech gets the same information.
import DefaultHero from '@astrojs/starlight/components/Hero.astro'
import TerminalDemo from './TerminalDemo.astro'
import { TEMPLATE_CATALOG } from '../data/template-catalog'

const { entry } = Astro.locals.starlightRoute
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'

const isHome = entry.id === 'index' || path === '/'
const isXtz = entry.id === 'xtarterize' || path === '/xtarterize'
const isCxa = entry.id === 'create-xtarter-app' || path === '/create-xtarter-app'
---

{
  !isHome && !isXtz && !isCxa ? (
    <DefaultHero />
  ) : isHome ? (
    <div class="hero xt-hero xt-hero-home">
      <div class="xt-hero-grid">
        <div class="xt-hero-copy">
          <p class="xt-eyebrow">xtarter &middot; two tools, one standard</p>
          <h1 id="_top" data-page-title>Start conformant. Stay conformant.</h1>
          <p class="xt-hero-lede">
            Scaffold new JavaScript &amp; TypeScript projects with
            create-xtarter-app, or bring existing ones up to standard with
            xtarterize. Biome, TypeScript strict, CI, and editor configs are
            handled either way.
          </p>
          <div class="xt-hero-actions">
            <a
              class="xt-btn xt-btn-primary"
              href="#starter-templates"
              data-umami-event="hero_lane_click"
              data-umami-event-product="create-xtarter-app"
              >Browse Templates</a
            >
            <a
              class="xt-btn xt-btn-ghost"
              href="/xtarterize/"
              data-umami-event="hero_lane_click"
              data-umami-event-product="xtarterize"
              >Get Started with xtarterize</a
            >
          </div>
        </div>
        <div class="xt-fork" aria-hidden="true" role="presentation">
          <div class="xt-fork-row">
            <span class="xt-fork-branch">├─</span>
            <span class="xt-fork-prompt">$</span>
            <code class="xt-fork-cmd">pnpm create xtarter-app</code>
          </div>
          <div class="xt-fork-row">
            <span class="xt-fork-branch">└─</span>
            <span class="xt-fork-prompt">$</span>
            <code class="xt-fork-cmd">npx xtarterize init</code>
          </div>
        </div>
      </div>
    </div>
  ) : isXtz ? (
    <div class="hero xt-hero xt-hero-xtz">
      <div class="xt-hero-grid">
        <div class="xt-hero-copy">
          <p class="xt-eyebrow">xtarterize &middot; conformance CLI</p>
          <h1 id="_top" data-page-title>The conformance CLI for JavaScript &amp; TypeScript</h1>
          <p class="xt-hero-lede">
            Detect your project&rsquo;s stack. Validate your configs. Keep everything
            in sync &mdash; without overwriting a single file without your say-so.
          </p>
          <div class="xt-hero-actions">
            <a class="xt-btn xt-btn-primary" href="/xtarterize/getting-started/installation/">Get Started</a>
            <a class="xt-btn xt-btn-ghost" href="/xtarterize/guide/cli/overview/">View CLI Reference</a>
          </div>
        </div>
        <TerminalDemo />
      </div>
    </div>
  ) : (
    <div class="hero xt-hero xt-hero-cxa">
      <div class="xt-hero-grid">
        <div class="xt-hero-copy">
          <p class="xt-eyebrow">create-xtarter-app &middot; scaffolding CLI</p>
          <h1 id="_top" data-page-title>Scaffold projects in seconds</h1>
          <p class="xt-hero-lede">
            Pick a template. Run one command. Get a fully configured project with
            linting, type checking, CI, and editor settings &mdash; ready to ship.
          </p>
          <div class="xt-hero-actions">
            <a class="xt-btn xt-btn-primary" href="/create-xtarter-app/getting-started/">Get Started</a>
            <a class="xt-btn xt-btn-ghost" href="/create-xtarter-app/guide/templates/">Browse Templates</a>
          </div>
        </div>
        <div class="xt-prompt" aria-hidden="true" role="presentation">
          <code class="xt-prompt-line">$ pnpm create xtarter-app</code>
          <span class="xt-prompt-q">?? Which template?</span>
          <ol class="xt-prompt-list">
            {TEMPLATE_CATALOG.map((t, i) => (
              <li class:list={{ 'xt-prompt-item': true, 'is-selected': i === 0 }}>
                <span class="xt-prompt-caret" aria-hidden="true">&rsaquo;</span>
                <span>{t.name}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  )
}
