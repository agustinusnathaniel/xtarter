---
// Type Starlight's App.Locals augmentation (starlightRoute) locally: the docs
// tsconfig does not include astro.config.mjs, so the integration's own d.ts
// files are not part of the program during `astro check`. The declaration
// merges with Starlight's when it is loaded.
declare global {
  namespace App {
    interface Locals {
      starlightRoute: import('@astrojs/starlight/route-data').StarlightRouteData
    }
  }
}
// Targeted Starlight Hero override for the three docs landing routes.
// For every other page it renders Starlight's default Hero unchanged, so
// hero frontmatter on non-target routes (404, future splash pages) keeps
// working. The `.hero` class and `<h1 id="_top" data-page-title>` are
// preserved so the existing tracking and page-title behavior stay intact;
// CTA labels are matched by text in Tracking.astro, so rename them there too.
//
// Every landing hero shares one shape: an expanded-width headline beside
// the lede and actions, then a full-width terminal replaying real CLI output
// (HeroTerminal + src/data/terminal-transcripts.ts).
import DefaultHero from '@astrojs/starlight/components/Hero.astro'
import HeroTerminal from './HeroTerminal.astro'

interface HeroAction {
  label: string
  href: string
  variant: 'primary' | 'ghost'
  umami?: Record<string, string>
}

interface LandingHeroContent {
  key: string
  titleLines: Array<string>
  lede: string
  actions: Array<HeroAction>
  transcripts: Array<string>
  caption: string
}

const XTZ_CAPTION =
  'The everyday loop: audit, preview, apply one task, roll back. Recorded against a Vite + React fixture with xtarterize 2.0.4; output trimmed.'

const HEROES: Record<string, LandingHeroContent> = {
  index: {
    key: 'home',
    titleLines: ['Start conformant.', 'Stay conformant.'],
    lede: "One strict baseline for every JavaScript and TypeScript repo: Biome, strict TypeScript, Git hooks, CI, and editor settings. Start new projects on it, bring existing ones up to it, and approve every change before it's written.",
    actions: [
      {
        label: 'Start with a template',
        href: '/create-xtarter-app/',
        variant: 'primary',
        umami: { event: 'hero_lane_click', product: 'create-xtarter-app' },
      },
      {
        label: 'Conform an existing repo',
        href: '/xtarterize/',
        variant: 'ghost',
        umami: { event: 'hero_lane_click', product: 'xtarterize' },
      },
    ],
    transcripts: ['create', 'check', 'init'],
    caption:
      'Real CLI output, trimmed. The xtarterize runs are against a Vite + React fixture.',
  },
  xtarterize: {
    key: 'xtz',
    titleLines: ['The conformance CLI for JavaScript and TypeScript'],
    lede: 'It detects your stack, audits your configs, and plans every change. Nothing is written until you approve the plan.',
    actions: [
      { label: 'Conform your project', href: '/xtarterize/getting-started/', variant: 'primary' },
      { label: 'View CLI Reference', href: '/xtarterize/guide/cli/overview/', variant: 'ghost' },
    ],
    transcripts: ['check', 'diff', 'add', 'undo'],
    caption: XTZ_CAPTION,
  },
  'create-xtarter-app': {
    key: 'cxa',
    titleLines: ['New project, fully configured'],
    lede: 'Pick a template, answer a few prompts, and start with linting, type checking, Git hooks, and editor settings already in place.',
    actions: [
      { label: 'Scaffold a project', href: '/create-xtarter-app/getting-started/', variant: 'primary' },
      { label: 'Browse Templates', href: '/create-xtarter-app/guide/templates/', variant: 'ghost' },
    ],
    transcripts: ['create'],
    caption: 'Prompts and log lines from create-xtarter-app; output trimmed.',
  },
}

const { entry } = Astro.locals.starlightRoute
// The home entry id varies by loader ('index' or ''), so fall back to the
// route path, stripped of slashes ('' for home).
const path = Astro.url.pathname.replace(/^\/+|\/+$/g, '')
const hero = HEROES[entry.id] ?? HEROES[path || 'index']

const umamiAttrs = (action: HeroAction) =>
  action.umami
    ? {
        'data-umami-event': action.umami.event,
        'data-umami-event-product': action.umami.product,
      }
    : {}
---

{
  hero ? (
    <div class={`hero xt-hero xt-hero-${hero.key}`}>
      <div class="xt-hero-head">
        <h1 id="_top" data-page-title>
          {hero.titleLines.map((line) => (
            <span class="xt-h1-line">{line}</span>
          ))}
        </h1>
        <div class="xt-hero-aside">
          <p class="xt-hero-lede">{hero.lede}</p>
          <div class="xt-hero-actions">
            {hero.actions.map((action) => (
              <a class={`xt-btn xt-btn-${action.variant}`} href={action.href} {...umamiAttrs(action)}>
                {action.label}
              </a>
            ))}
          </div>
        </div>
      </div>
      <HeroTerminal ids={hero.transcripts} caption={hero.caption} />
    </div>
  ) : (
    <DefaultHero />
  )
}
