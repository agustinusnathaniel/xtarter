---
declare global {
  namespace App {
    interface Locals {
      starlightRoute: import('@astrojs/starlight/route-data').StarlightRouteData
    }
  }
}

import DefaultHero from '@astrojs/starlight/components/Hero.astro'
import LandingRouteNav from './LandingRouteNav.astro'
import TerminalDemo from './TerminalDemo.astro'
import { TEMPLATE_CATALOG } from '@/data/template-catalog'

type LandingRoute = 'home' | 'create' | 'xtarterize'
type HeroProduct = 'create-xtarter-app' | 'xtarterize'
type HeroEvent = 'hero_lane_click' | 'hero_cta_browse' | 'hero_cta_get_started' | 'hero_cta_cli_reference'

interface HeroAction {
  event: HeroEvent
  href: string
  intent: string
  label: string
  product: HeroProduct
}

interface HeroContent {
  context: string
  lede: string
  next: string
  primary: HeroAction
  secondary: HeroAction
  title: string
}

const { entry } = Astro.locals.starlightRoute
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'

const isHome = entry.id === 'index' || path === '/'
const isCreate = entry.id === 'create-xtarter-app' || path === '/create-xtarter-app'
const isXtz = entry.id === 'xtarterize' || path === '/xtarterize'
const isLanding = isHome || isCreate || isXtz
const route: LandingRoute = isHome ? 'home' : isCreate ? 'create' : 'xtarterize'

const heroByRoute: Record<LandingRoute, HeroContent> = {
  home: {
    context: 'Two tools. One known-good baseline.',
    lede: 'Start a JavaScript or TypeScript repository with create-xtarter-app, or inspect an existing repository with xtarterize. See the plan, choose the next action, and keep the result maintainable.',
    next: 'Start with a template or inspect an existing repository.',
    primary: {
      event: 'hero_lane_click',
      href: '/create-xtarter-app/',
      intent: 'scaffold',
      label: 'Scaffold a new repo',
      product: 'create-xtarter-app',
    },
    secondary: {
      event: 'hero_lane_click',
      href: '/xtarterize/',
      intent: 'preview',
      label: 'Preview an existing repo',
      product: 'xtarterize',
    },
    title: 'Make the repo legible.',
  },
  create: {
    context: 'A deliberate first commit starts with a choice.',
    lede: 'create-xtarter-app asks for a project name, template, package manager, and Git preference before it downloads a documented starter. A documented stack summary is visible before you commit to it.',
    next: 'Choose a template, then review the first-run decisions.',
    primary: {
      event: 'hero_cta_get_started',
      href: '/create-xtarter-app/getting-started/',
      intent: 'scaffold',
      label: 'Scaffold a project',
      product: 'create-xtarter-app',
    },
    secondary: {
      event: 'hero_cta_browse',
      href: '/create-xtarter-app/guide/templates/',
      intent: 'templates',
      label: 'Compare templates',
      product: 'create-xtarter-app',
    },
    title: 'Choose a baseline.',
  },
  xtarterize: {
    context: 'Existing repository? Start with a receipt, not a rewrite.',
    lede: 'xtarterize detects the project, selects applicable conformance tasks, and shows a plan with explicit statuses. Preview first, then apply the changes that belong in your repository.',
    next: 'Run a dry run before an apply run.',
    primary: {
      event: 'hero_cta_get_started',
      href: '/xtarterize/getting-started/initialization/',
      intent: 'preview',
      label: 'Preview a plan',
      product: 'xtarterize',
    },
    secondary: {
      event: 'hero_cta_cli_reference',
      href: '/xtarterize/guide/cli/overview/',
      intent: 'cli',
      label: 'Read the CLI',
      product: 'xtarterize',
    },
    title: 'Inspect before you change.',
  },
}

const hero = heroByRoute[route]
---

{
  !isLanding ? (
    <DefaultHero />
  ) : (
    <div class:list={['hero', 'xt-hero', 'xt-landing-hero', `xt-hero-${route}`]}>
      <div class="xt-hero-shell">
        <LandingRouteNav current={route} />
        <div class="xt-hero-grid">
          <div class="xt-hero-copy">
            <h1 id="_top" data-page-title>{hero.title}</h1>
            <p class="xt-hero-context">
              <span class="xt-signal" aria-hidden="true" />
              {hero.context}
            </p>
            <p class="xt-hero-lede">{hero.lede}</p>
            <div class="xt-hero-actions">
              <a
                class="xt-btn xt-btn-primary"
                href={hero.primary.href}
                data-umami-event={hero.primary.event}
                data-umami-event-intent={hero.primary.intent}
                data-umami-event-product={hero.primary.product}
              >
                {hero.primary.label}
              </a>
              <a
                class="xt-btn xt-btn-secondary"
                href={hero.secondary.href}
                data-umami-event={hero.secondary.event}
                data-umami-event-intent={hero.secondary.intent}
                data-umami-event-product={hero.secondary.product}
              >
                {hero.secondary.label}
              </a>
            </div>
            <p class="xt-hero-next">
              <span>Next</span>
              {hero.next}
            </p>
          </div>

          {route === 'home' ? (
            <figure class="xt-artifact xt-home-rail">
              <figcaption class="xt-artifact-bar">
                <span>repository paths</span>
                <span>choose one</span>
              </figcaption>
              <div class="xt-home-rail-body" aria-hidden="true">
                <div class="xt-home-rail-row">
                  <span class="xt-rail-state">new</span>
                  <div class="xt-rail-copy">
                    <code>create-xtarter-app</code>
                    <span>choose a template</span>
                  </div>
                </div>
                <div class="xt-home-rail-row">
                  <span class="xt-rail-state">existing</span>
                  <div class="xt-rail-copy">
                    <code>xtarterize init</code>
                    <span>inspect the plan</span>
                  </div>
                </div>
              </div>
              <p class="xt-artifact-summary">
                New repository or existing repository, both paths end at a visible baseline.
              </p>
            </figure>
          ) : route === 'create' ? (
            <figure class="xt-artifact xt-template-manifest">
              <figcaption class="xt-artifact-bar">
                <span>template manifest</span>
                <span>catalog / 05</span>
              </figcaption>
              <div class="xt-template-manifest-body" aria-hidden="true">
                <code class="xt-manifest-command">pnpm create xtarter-app@latest</code>
                <p class="xt-manifest-question">select a starting point</p>
                <ol class="xt-manifest-list">
                  {TEMPLATE_CATALOG.map((template, index) => (
                    <li class:list={{ 'xt-manifest-item': true, 'is-selected': index === 0 }}>
                      <span class="xt-manifest-caret" aria-hidden="true">›</span>
                      <span>{template.name}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <p class="xt-artifact-summary">
                Five documented starting points. Each catalog card shows selected stack highlights.
              </p>
            </figure>
          ) : (
            <TerminalDemo />
          )}
        </div>
      </div>
    </div>
  )
}
