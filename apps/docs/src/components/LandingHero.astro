---
// Type Starlight's App.Locals augmentation (starlightRoute) locally: the docs
// tsconfig does not include astro.config.mjs, so the integration's own d.ts
// files are not part of the program during `astro check`. The declaration
// merges with Starlight's when it is loaded.
declare global {
  namespace App {
    interface Locals {
      starlightRoute: import('@astrojs/starlight/route-data').StarlightRouteData
    }
  }
}
// The three product entry routes use custom heroes. Other splash pages
// keep Starlight's default hero and frontmatter behavior.
import DefaultHero from '@astrojs/starlight/components/Hero.astro'
import HomeHero from './HomeHero.astro'
import TerminalDemo from './TerminalDemo.astro'
import { TEMPLATE_CATALOG } from '@/data/template-catalog'

const { entry } = Astro.locals.starlightRoute
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'

const isHome = entry.id === 'index' || path === '/'
const isXtz = entry.id === 'xtarterize' || path === '/xtarterize'
const isCxa = entry.id === 'create-xtarter-app' || path === '/create-xtarter-app'
---

{
  !isHome && !isXtz && !isCxa ? (
    <DefaultHero />
  ) : isHome ? (
    <HomeHero />
  ) : isXtz ? (
    <div class="hero xt-hero xt-hero-dark xt-hero-xtz">
      <div class="xt-hero-grid">
        <div class="xt-hero-copy">
          <p class="xt-eyebrow">xtarterize</p>
          <h1 id="_top" data-page-title>Bring your project up to standard.</h1>
          <p class="xt-hero-lede">
            Detects your JavaScript or TypeScript stack, previews configuration changes, and asks
            before applying them.
          </p>
          <div class="xt-hero-actions">
            <a class="xt-btn xt-btn-primary" href="/xtarterize/getting-started/">Conform your project</a>
            <a class="xt-btn xt-btn-ghost-dark" href="/xtarterize/guide/cli/overview/">View CLI Reference</a>
          </div>
        </div>
        <TerminalDemo />
      </div>
    </div>
  ) : (
    <div class="hero xt-hero xt-hero-dark xt-hero-cxa">
      <div class="xt-hero-grid">
        <div class="xt-hero-copy">
          <p class="xt-eyebrow">create-xtarter-app</p>
          <h1 id="_top" data-page-title>New project, fully configured</h1>
          <p class="xt-hero-lede">
            Pick a template, run one command, and get linting, type checking,
            CI, and editor settings.
          </p>
          <div class="xt-hero-actions">
            <a class="xt-btn xt-btn-primary" href="/create-xtarter-app/getting-started/">Scaffold a project</a>
            <a class="xt-btn xt-btn-ghost-dark" href="/create-xtarter-app/guide/templates/">Browse Templates</a>
          </div>
        </div>
        <div class="xt-prompt" aria-hidden="true" role="presentation">
          <code class="xt-prompt-line">$ pnpm create xtarter-app@latest<span class="xt-cursor" aria-hidden="true"></span></code>
          <span class="xt-prompt-q">?? Which template?</span>
          <ol class="xt-prompt-list">
            {TEMPLATE_CATALOG.map((t, i) => (
              <li class:list={{ 'xt-prompt-item': true, 'is-selected': i === 0 }}>
                <span class="xt-prompt-caret" aria-hidden="true">&rsaquo;</span>
                <span>{t.name}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  )
}
