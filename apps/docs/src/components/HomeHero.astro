---
import '@/styles/home.css'

const files = [
  { name: 'biome.json', purpose: 'Lint & format' },
  { name: 'tsconfig.json', purpose: 'Strict types' },
  { name: '.github/workflows/', purpose: 'CI checks' },
  { name: '.vscode/', purpose: 'Editor settings' },
  { name: '.agents/skills/', purpose: 'Agent guidance' },
]
---

<div class="hero xt-home-hero">
  <div class="xt-home-intro">
    <p class="xt-home-context">A solid start for JavaScript &amp; TypeScript</p>
    <h1 id="_top" data-page-title>Start building.<br />Skip the setup.</h1>
    <p class="xt-home-lede">
      Your next idea deserves more than another afternoon configuring tools.
      Start a project with a ready-to-use template, or bring the same
      standards to the code you already have.
    </p>
    <div class="xt-home-actions">
      <a class="xt-home-button" href="/create-xtarter-app/getting-started/"
        data-umami-event="hero_lane_click" data-umami-event-product="create-xtarter-app">
        Start a new project
      </a>
      <a class="xt-home-button xt-home-button-secondary" href="/xtarterize/getting-started/"
        data-umami-event="hero_lane_click" data-umami-event-product="xtarterize">
        Improve an existing repo
      </a>
    </div>
    <p class="xt-home-footnote">Open source. Yours to build on.</p>
  </div>

  <figure class="xt-project" aria-label="Illustrative project with application code and a configured development baseline">
    <div class="xt-project-heading">
      <svg class="xt-project-mark" width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <rect width="48" height="48" rx="12" fill="currentColor" />
        <path d="M15 15L33 33M33 15L15 33" stroke="white" stroke-width="3" stroke-linecap="round" />
      </svg>
      <div><span class="xt-project-title">your-next-project</span><span class="xt-project-subtitle">A place for your next big idea</span></div>
      <span class="xt-project-branch">main</span>
    </div>
    <div class="xt-project-code">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7V5a1 1 0 0 1 1-1h5l2 3h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7Z" /></svg>
      <code>src/</code><span>Your code goes here</span>
    </div>
    <div class="xt-project-baseline">
      <div class="xt-project-baseline-title"><span>The setup, taken care of</span><span>Example baseline</span></div>
      <ul>
        {files.map((file) => (
          <li><span class="xt-project-check" aria-hidden="true">✓</span><code>{file.name}</code><span>{file.purpose}</span></li>
        ))}
      </ul>
    </div>
    <figcaption class="xt-project-caption"><span aria-hidden="true">⌁</span> Less configuration. More creation.</figcaption>
  </figure>
</div>
