---
import { TEMPLATE_CATALOG } from '@/data/template-catalog'
---

<ul class="xt-gallery">
  {
    TEMPLATE_CATALOG.map((template) => (
      <li class="xt-tpl">
        <a
          class="xt-tpl-card"
          href={`https://github.com/${template.repo}`}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="template_click"
          data-umami-event-template_name={template.name}
          data-template-id={template.id}
        >
          <span class="xt-tpl-context">
            {template.id.startsWith('next') ? 'Next.js' : 'Vite+'}
          </span>
          <span class="xt-tpl-name">{template.name}</span>
          <span class="xt-tpl-desc">{template.description}</span>
          <span class="xt-tpl-stack">
            <span class="xt-tpl-stack-label">Stack</span>
            {template.stack.map((item) => (
              <span class="xt-tpl-chip">{item}</span>
            ))}
          </span>
          <span class="xt-tpl-action">
            Open repository
            <span class="xt-visually-hidden">(opens in a new tab)</span>
            <span class="xt-tpl-arrow" aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
