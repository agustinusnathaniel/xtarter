---
// Static template table. Renders records from the manually maintained
// template catalog in src/data/template-catalog.ts - no network, no GitHub
// API, no star counts. Ownership of the catalog is documented in that file.
//
// A ruled table rather than a card grid: the templates differ only by stack,
// so rows let readers compare them in one scan. The name links to the
// repository; the last column is the flag that skips the template prompt.
// Styling lives in global.css under `.xt-templates`.
import { TEMPLATE_CATALOG } from '@/data/template-catalog'
---

<div class="xt-templates-wrap not-content">
  <table class="xt-templates">
    <thead>
      <tr>
        <th scope="col">Template</th>
        <th scope="col">Stack</th>
        <th scope="col">Flag</th>
      </tr>
    </thead>
    <tbody>
      {
        TEMPLATE_CATALOG.map((t) => (
          <tr>
            <th scope="row">
              <a
                class="xt-templates-name"
                href={`https://github.com/${t.repo}`}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="template_click"
                data-umami-event-template_name={t.name}
              >
                {t.name}
              </a>
              <span class="xt-templates-desc">{t.description}</span>
            </th>
            <td class="xt-templates-stack">{t.stack.join(', ')}</td>
            <td>
              <code class="xt-templates-flag">-t {t.id}</code>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
