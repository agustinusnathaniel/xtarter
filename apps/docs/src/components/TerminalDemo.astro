<div class="xt-terminal-wrap">
  <figure class="xt-terminal xt-plan-receipt">
    <figcaption class="xt-terminal-bar">
      <span>xtarterize / plan receipt</span>
      <span class="xt-terminal-mode">preview</span>
    </figcaption>

    <div class="xt-terminal-body" aria-hidden="true">
      <div class="xt-receipt-command">
        <span class="xt-term-prompt">$</span>
        <code>pnpx xtarterize@latest init --dry-run</code>
      </div>

      <div class="xt-receipt-record">
        <span class="xt-receipt-label">profile</span>
        <span class="xt-receipt-value">Vite + React + TypeScript / pnpm</span>
      </div>

      <div class="xt-receipt-rule"></div>
      <p class="xt-receipt-heading">Proposed changes</p>

      <ul class="xt-receipt-list">
        <li class="xt-receipt-row">
          <span class="xt-receipt-status is-new">new</span>
          <code>lint/biome</code>
          <span class="xt-receipt-change">add lint + format config</span>
        </li>
        <li class="xt-receipt-row">
          <span class="xt-receipt-status is-patch">patch</span>
          <code>ts/strict</code>
          <span class="xt-receipt-change">tighten compiler options</span>
        </li>
        <li class="xt-receipt-row">
          <span class="xt-receipt-status is-new">new</span>
          <code>ci/ci</code>
          <span class="xt-receipt-change">add GitHub Actions</span>
        </li>
        <li class="xt-receipt-row">
          <span class="xt-receipt-status is-new">new</span>
          <code>editor/vscode</code>
          <span class="xt-receipt-change">add editor settings</span>
        </li>
        <li class="xt-receipt-row">
          <span class="xt-receipt-status is-skip">skip</span>
          <code>release/commitlint</code>
          <span class="xt-receipt-change">already conformant</span>
        </li>
      </ul>

      <div class="xt-receipt-next">
        <span class="xt-receipt-label">next</span>
        <strong>run init to apply</strong>
      </div>
      <p class="xt-receipt-footnote">preview only, no backups created</p>
    </div>
  </figure>

  <p class="xt-terminal-summary">
    Example receipt for a Vite + React + TypeScript project. <code>--dry-run</code> plans changes without
    writing conformance files or creating backups. The session may add <code>/.xtarterize/</code> to
    <code>.gitignore</code>; apply creates backups before modifying files.
  </p>
</div>
