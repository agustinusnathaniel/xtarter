---
// Homepage two-tool split: one ruled panel per entry point, named by the
// situation the reader is in ("New project" / "Existing repo") with the CLI
// name underneath. Each cell holds a copyable command and one guide link, so
// the cell itself is not a link (no nested interactive content).
// Styling lives in apps/docs/src/styles/global.css (`.xt-split*`).
import CopyCommand from './CopyCommand.astro'

const cells = [
  {
    situation: 'New project',
    product: 'create-xtarter-app',
    body: 'Pick one of five templates. The baseline is in place before your first commit.',
    command: 'pnpm create xtarter-app@latest',
    href: '/create-xtarter-app/',
    link: 'Read the create-xtarter-app guide',
  },
  {
    situation: 'Existing repo',
    product: 'xtarterize',
    body: 'Audit your configs, preview the plan, and apply only what you approve. Originals are backed up first.',
    command: 'pnpx xtarterize@latest init',
    href: '/xtarterize/',
    link: 'Read the xtarterize guide',
  },
] as const
---

<div class="xt-split not-content">
  {
    cells.map((cell) => (
      <section class="xt-split-cell" aria-labelledby={`split-${cell.product}`}>
        <h3 class="xt-split-title" id={`split-${cell.product}`}>
          {cell.situation}
          <span class="xt-split-product">{cell.product}</span>
        </h3>
        <p class="xt-split-body">{cell.body}</p>
        <CopyCommand command={cell.command} />
        <a
          class="xt-link xt-split-link"
          href={cell.href}
          data-umami-event="tool_card_click"
          data-umami-event-product={cell.product}
        >
          {cell.link}
        </a>
      </section>
    ))
  }
</div>
