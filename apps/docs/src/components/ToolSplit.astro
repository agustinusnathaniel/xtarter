---
interface ToolCard {
  action: string
  body: string
  cmd: string
  context: string
  href: string
  product: string
  role: string
}

const cards: ToolCard[] = [
  {
    action: 'Scaffold a project',
    body: 'Choose a documented stack, install dependencies, and start with a repository you can extend.',
    cmd: 'pnpm create xtarter-app@latest',
    context: 'New repository',
    href: '/create-xtarter-app/',
    product: 'create-xtarter-app',
    role: 'Start from a template.',
  },
  {
    action: 'Preview a repository',
    body: 'Detect the stack, read the plan, and apply the changes that belong in your project.',
    cmd: 'pnpx xtarterize@latest init --dry-run',
    context: 'Existing repository',
    href: '/xtarterize/',
    product: 'xtarterize',
    role: 'Make the current state inspectable.',
  },
]
---

<ul class="xt-split">
  {
    cards.map((card) => (
      <li class="xt-tool-item">
        <a
          class="xt-tool-card"
          href={card.href}
          data-umami-event="tool_card_click"
          data-umami-event-product={card.product}
        >
          <span class="xt-tool-context">{card.context}</span>
          <h3 class="xt-tool-name">{card.product}</h3>
          <p class="xt-tool-role">{card.role}</p>
          <p class="xt-tool-body">{card.body}</p>
          <code class="xt-tool-cmd">{card.cmd}</code>
          <span class="xt-tool-action">
            {card.action}
            <span class="xt-tool-arrow" aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
