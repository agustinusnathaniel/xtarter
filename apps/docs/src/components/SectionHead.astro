---
interface Props {
  context?: string
  id?: string
  lead?: string
  title: string
}

const { context, id, lead, title } = Astro.props
---

<div class:list={['xt-section-head', context && 'has-context']}>
  <div class="xt-section-head-body">
    <h2 class="xt-section-title" id={id}>{title}</h2>
    {lead && <p class="xt-section-lead">{lead}</p>}
  </div>
  {context && <p class="xt-section-context">{context}</p>}
</div>
