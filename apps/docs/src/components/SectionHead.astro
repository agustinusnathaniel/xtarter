---
// Shared landing-page section head: title + optional lead composed into one
// `.xt-section-head` unit. All styling lives in
// apps/docs/src/styles/global.css (`.xt-section-head`, `.xt-section-title`,
// `.xt-section-lead`) - this component carries no scoped styles.
//
// Rhythm contract: a standalone SectionHead rendered directly in MDX gets a
// top beat from global.css; when the page builder wraps the whole section in
// `<div class="xt-section">...</div>`, the wrapper owns the beat instead.
export interface Props {
  title: string
  id?: string
  lead?: string
}

const { title, id, lead } = Astro.props
---

<div class="xt-section-head not-content">
  <h2 class="xt-section-title" id={id}>{title}</h2>
  {lead && <p class="xt-section-lead">{lead}</p>}
</div>
