{
  "name": "xtarterize",
  "version": "2.0.4",
  "description": "Automated project setup and configuration scaffolding",
  "keywords": [
    "boilerplate",
    "cli",
    "project-setup",
    "scaffold",
    "starter",
    "template"
  ],
  "homepage": "https://xtarter.sznm.dev/xtarterize",
  "bugs": {
    "url": "https://github.com/agustinusnathaniel/xtarter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agustinusnathaniel/xtarter",
    "directory": "apps/xtarterize"
  },
  "license": "MIT",
  "author": "agustinusnathaniel",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "xtarterize": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "citty": "catalog:",
    "cli-table3": "^0.6.5",
    "jsonc-parser": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@xtarterize/core": "workspace:*",
    "@xtarterize/patchers": "workspace:*",
    "@xtarterize/tasks": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
