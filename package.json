{
  "name": "xtarter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "postbuild": "pnpm verify:shebangs",
    "build:ci": "turbo run build --filter=!@xtarter/docs",
    "postbuild:ci": "pnpm verify:shebangs",
    "changeset": "changeset",
    "check": "turbo run typecheck build ultracite:check test verify:shebangs",
    "check:ci": "turbo run typecheck build ultracite:check test verify:shebangs --filter=!@xtarter/docs",
    "contributors:add": "all-contributors add",
    "contributors:check": "all-contributors check",
    "contributors:generate": "all-contributors generate",
    "dev": "turbo run dev",
    "docs:build": "pnpm --filter @xtarter/docs build",
    "docs:dev": "pnpm --filter @xtarter/docs dev",
    "docs:preview": "pnpm --filter @xtarter/docs preview",
    "prepare": "vp config",
    "release": "changeset publish",
    "test": "vp test",
    "typecheck": "turbo run typecheck",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "up-interactive": "pnpm up -i -r",
    "up-latest": "pnpm up-interactive -L",
    "verify:shebangs": "node scripts/verify-shebangs.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "catalog:",
    "all-contributors-cli": "^6.26.1",
    "turbo": "^2.10.11",
    "ultracite": "7.10.7",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.15.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  }
}
