{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "vite.config.ts"],
      "outputs": ["dist/**"]
    },
    "@xtarter/create#build": {
      "outputs": [],
      "cache": false
    },
    "@xtarter/docs#typecheck": {
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": [".tsbuildinfo"]
    },
    "//#ultracite:check": {
      "cache": false
    },
    "//#ultracite:fix": {
      "cache": false
    },
    "//#verify:shebangs": {
      "dependsOn": ["^build"]
    },
    "//#test": {
      "dependsOn": ["xtarterize#build", "create-xtarter-app#build"],
      "inputs": [
        "vite.config.ts",
        "test/",
        "packages/*/src/**",
        "apps/*/src/**",
        "!test/fixtures/**/.xtarterize/**"
      ],
      "outputs": ["node_modules/.vite/vitest/*"]
    }
  }
}
